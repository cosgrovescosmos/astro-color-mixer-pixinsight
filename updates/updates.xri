<?xml version="1.0" encoding="UTF-8"?>

<xri version="1.0">

  <description>
    <p>Cosgrove's Cosmos PixInsight script repository</p>
  </description>

  <platform os="all" arch="noarch" version="1.8.0:1.9.9">

    <package
      fileName="AstroColorMixer-0.9.7.14-beta.zip"
      sha1="3a03a72b5130b058593eacb27a3329c58141b9dc"
      type="script"
      releaseDate="20260727"
      remove="src/scripts/CosgrovesCosmos/AstroColorMixer.js">

      <title>Astro Color Mixer v0.9.7.14-beta</title>

      <description>
        <p>Astro Color Mixer is a PixInsight script for nonlinear RGB color and luminance refinement in astrophotography.</p>
        <p><b>What's new:</b> Restores the Astro Color Mixer script menu icon using the validated colon feature-id plus flat SVG script icon package.</p>
        <p>The installed script declares #feature-id AstroColorMixer : Cosgrove's Cosmos &gt; Astro Color Mixer and #feature-icon @script_icons_dir/AstroColorMixer.svg.</p>
        <p>Processing math, masks, probe behavior, histogram and polar plot math, recipes, preview behavior, passes, layout target sizes, output behavior, and the display scaling warning from v0.9.7.11-beta are unchanged.</p>
        <p>This is a beta release for testing. PixInsight 1.9.4 or newer is recommended; Apple Silicon Mac users should use the ARM64/Apple-Silicon PixInsight build.</p>
      </description>

    </package>

    <package
      fileName="AstroContrastEnhancer-0.9.599.zip"
      sha1="bc8f3e90d7a3870e2d9bb8b8b1bb80e70d504a53"
      type="script"
      releaseDate="20260802">

      <title>Astro Contrast Enhancer v0.9.599</title>

      <description>
        <p>Astro Contrast Enhancer provides protected Texture, Clarity, Dehaze, and lasso-based local contrast control for stretched astrophotography images.</p>
        <p><b>What's new:</b> Removes an unintended advanced texture model selector from the public interface. The product texture algorithm is unchanged.</p>
        <p>This release includes the Cosgrove's Cosmos Non-Commercial Source License. Personal, educational, research, and other non-commercial use is permitted with attribution. Commercial use requires prior written permission from Patrick A. Cosgrove.</p>
        <p>This release changes ACE interface visibility only. It does not change PixInsight package paths, feature-id, menu placement, or icon path.</p>
      </description>

    </package>

  </platform>

</xri>
